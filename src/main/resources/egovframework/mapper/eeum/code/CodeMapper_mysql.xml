<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.eeum.code.service.code.dao.CodeMapper">

    <!-- 그룹의 사용중·활성 공통코드 — 정렬순서, 동률 시 SN. (IX_COMM_CD_GROUP_SORT 활용) -->
    <select id="selectActiveCodesByGroup" resultType="egovframework.eeum.code.vo.CommCdVO">
        SELECT GROUP_CD, CD, CD_NM, SORT_SEQ
          FROM COMM_CD
         WHERE GROUP_CD = #{groupCd}
           AND USE_YN = 'Y'
           AND DEL_YN = 'N'
         ORDER BY SORT_SEQ, COMM_CD_SN
    </select>

</mapper>
