# 이음 백엔드 환경변수 — 개발서버용 템플릿.
# 실제 파일은 /etc/eeum/eeum.env 에 두고 chmod 600 (비밀 — 커밋 금지).
# 항목 설명은 저장소 .env.develop 참고.

SPRING_PROFILE=dev
SERVER_PORT=8082

# ── MySQL (DB 서버) ──
DB_HOST=minoservers.iptime.org
DB_PORT=30006
DB_NAME=eeum
DB_USERNAME=
DB_PASSWORD=

# ── Redis (DB 서버, ACL 사용자 eeum) ──
REDIS_HOST=minoservers.iptime.org
REDIS_PORT=30007
REDIS_USERNAME=eeum
REDIS_PASSWORD=

# ── 보안 키 (서버 전용 무작위값 — openssl rand -base64 48 로 생성 권장) ──
EGOV_JWT_SECRET=
EGOV_CRYPTO_KEY=

# ── CORS 허용 origin (프론트 dev 서버 — 콤마로 복수) ──
CORS_ALLOW_ORIGIN=http://localhost:3000

# ── 쿠키 (dev 는 HTTP 라 false) ──
JWT_COOKIE_SECURE=false
